# Copy to .env and fill in. Get a key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=

MODEL=gemini-3.8-flash
# Switchable at runtime from the tray menu ("Use fast model").
FAST_MODEL=gemini-3.5-flash-lite

HOTKEY=ctrl+shift+space

# Hard cap on output. Gemini counts *thinking* tokens against this too, so if
# answers get cut off, raise it (e.g. 2000).
MAX_TOKENS=1000

# off/minimal = the lowest level the model supports (that is "low" on
# gemini-3.8-flash, which rejects "minimal"). Also: low, medium, high,
# or default (let the model decide).
THINKING=minimal

# Ignored by Gemini 3.6+ and 3.5 Flash-Lite; honoured by older models.
TEMPERATURE=0.3

# Send PNG instead of JPEG (larger and slower).
SEND_PNG=false

# Save images, prompt and response to captures/<timestamp>/
SAVE_CAPTURES=false
